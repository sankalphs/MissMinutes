# MissMinutes — environment configuration
# Copy to .env and fill values. NEVER commit .env.

# --- LLM (GMI / MiniMax-M3) ---
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_API_KEY=
GMI_MODEL=MiniMaxAI/MiniMax-M3

# --- Subtitles (Wyzie) ---
WYZIE_API_KEY=
WYZIE_BASE_URL=https://sub.wyzie.io
WYZIE_DAILY_LIMIT=1000

# --- Knowledge Graph (Neo4j Aura) ---
NEO4J_URI=neo4j+s://
NEO4J_USERNAME=4a47202a
NEO4J_PASSWORD=
NEO4J_DATABASE=4a47202a

# --- Vector DB (Qdrant Cloud) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Embeddings (HF, local inference) ---
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_DIM=384

# --- App ---
DATABASE_PATH=data/missminutes.db
HF_TOKEN=
